# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=netopsys_db

# Database URL for Prisma Connection
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/netopsys_db?schema=public

# Session Security
SESSION_SECRET=your_secure_session_secret_here

# Google reCAPTCHA v3 Configuration
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_EXPECTED_ACTION=contact_form_submit
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1,netopsys.ai,www.netopsys.ai
CONTACT_RATE_LIMIT_MAX=15
# Optional Google Cloud Enterprise / CreateAssessment API Configuration
# RECAPTCHA_PROJECT_ID=your_gcp_project_id
# RECAPTCHA_API_KEY=your_gcp_api_key
# RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Live Email Transmission: Configure EITHER Direct SMTP OR Resend API
# Option 1: Direct SMTP (Recommended for helpdesk@netopsys.net - Google Workspace / Hostinger / Zoho / cPanel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=helpdesk@netopsys.net
# SMTP_PASS=your_email_or_app_password
# SMTP_SECURE=false

# Option 2: Resend API Key (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

EMAIL_FROM=Netopsys AI <helpdesk@netopsys.net>
FRONTEND_URL=http://localhost:5173
